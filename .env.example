# 이 파일을 .env.local 로 복사해서 값을 채운다. 비워 두면 로컬 모드(.data/db.json)로 동작한다.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 모드 세션 서명 키 (비우면 .data/session-secret 을 자동 생성)
AUTH_SECRET=

# AI 이미지 생성 (4단계). 비우면 목업 이미지로 동작
AI_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 포트원 V2 (5단계, 테스트 모드)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

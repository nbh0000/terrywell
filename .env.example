# 이 파일을 .env.local 로 복사해서 값을 채운다. 비워 두면 로컬 모드(.data/db.json)로 동작한다.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 모드 세션 서명 키 (비우면 .data/session-secret 을 자동 생성)
AUTH_SECRET=

# 간편 로그인 (카카오·네이버·구글). 둘 다 있어야 그 버튼이 동작하고, 없으면 '연결되지 않음' 안내
# 각 콘솔에 등록할 Redirect/Callback URL: {NEXT_PUBLIC_SITE_URL}/auth/callback/kakao|naver|google
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 개발 확인용: 1 이면 제공자에 가지 않고 가짜 회원으로 로그인 (운영 빌드에서는 무시)
OAUTH_FAKE=

# AI 이미지 생성. AI_PROVIDER=mock 이면 키 없이 목업 이미지(비용 없음)
# mock | openai | google
AI_PROVIDER=mock
# 한 번 생성할 때 결과 장수 (하루 횟수는 요청 1번 = 1회)
AI_IMAGES_PER_REQUEST=2
# 장당 예상 비용(원), 관리자 사용량 추정치에 사용
AI_COST_PER_IMAGE_KRW=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

# 관리자 알림 (선택): 견적문의 접수 시 JSON 을 POST 할 웹훅 주소 (Slack/메일 연동 등)
NOTIFY_WEBHOOK_URL=

# 포트원 V2 (테스트 채널 키로 먼저). 셋 중 하나라도 비면 사이트 안의 테스트 결제로 동작
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

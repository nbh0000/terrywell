# 개발 서버(next dev) 설정. 데이터·인증·저장은 로컬 Apache+PHP(php/ 폴더, 기본 http://localhost:8090)가 맡는다.
# PHP 쪽 설정은 php/api/config.php (config.sample.php 참고), 실서버 값은 cafe24/secrets.txt → deploy.py 가 config.php 를 만든다.

# 로컬 PHP API 주소 (next.config.ts 가 /api, /uploads, /auth/* 를 이리로 넘긴다)
TW_API_ORIGIN=http://localhost:8090

# 정적 내보내기 빌드(카페24용)일 때 1. python cafe24/build.py 가 넣는다
TW_EXPORT=

# 빌드 때 사이트 주소 (간편 로그인 콜백·메일 링크는 PHP config 의 site_url 을 쓴다)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이 파일을 .env.local 로 복사해서 값을 채운다. 비워 두면 로컬 모드(.data/db.json)로 동작한다.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 모드 세션 서명 키 (비우면 .data/session-secret 을 자동 생성)
AUTH_SECRET=

# AI 이미지 생성. AI_PROVIDER=mock 이면 키 없이 목업 이미지(비용 없음)
AI_PROVIDER=mock            # mock | openai | google
AI_IMAGES_PER_REQUEST=2     # 한 번 생성할 때 결과 장수 (하루 횟수는 요청 1번 = 1회)
AI_COST_PER_IMAGE_KRW=      # 장당 예상 비용(원), 관리자 사용량 추정치에 사용
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

# 포트원 V2 (5단계, 테스트 모드)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
